generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// Normal schema change (dev)     npx prisma migrate dev
// First time DB setup npx prisma migrate dev
// Just edited Prisma Client usage npx prisma generate

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  password      String
  role          Role     @default(USER)
  picture       String?
  // Teacher specific fields
  teacherId     String?
  // Student specific fields
  roll          String?
  sectionId     String?
  section       Section? @relation("StudentSection", fields: [sectionId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  notices              Notice[]
  teacherAssignments   TeacherAssignment[]  @relation("TeacherAssignments")
  classTeacherOf       Section[]            @relation("ClassTeacher")
  attendancesTaken     Attendance[]         @relation("AttendanceTakenBy")
  studentAttendances   Attendance[]         @relation("StudentAttendance")
  studentMarks         StudentMark[]        @relation("StudentMarks")
  // Student Panel relations
  submissions          AssignmentSubmission[] @relation("StudentSubmissions")
  notifications        Notification[]         @relation("UserNotifications")
  // Teacher Panel relations (new)
  routinesTeaching     ClassRoutine[]         @relation("RoutineTeacher")
  assignmentsCreated   Assignment[]           @relation("AssignmentTeacher")
  materialsUploaded    StudyMaterial[]        @relation("MaterialTeacher")
}

model Institution {
  id            String         @id @default(cuid())
  name          String         @unique
  status        String         @default("inactive")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Relations
  subscriptions Subscription[]
  notices       Notice[]
  users         User[]
  classes       Class[]
  subjects      Subject[]
  exams         Exam[]
}

model Plan {
  id            String         @id @default(cuid())
  name          String         @unique
  price         Float
  billingCycle  String         @default("monthly") // monthly, yearly
  features      String[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id              String      @id @default(cuid())
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan        @relation(fields: [planId], references: [id])
  amount          Float
  paymentStatus   String      @default("due") // paid, due, overdue
  billingCycle    String      @default("monthly") // monthly, yearly
  startDate       DateTime    @default(now())
  endDate         DateTime
  paidAt          DateTime?
  transactionId   String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Notice {
  id          String    @id @default(cuid())
  title       String
  content     String
  priority    String    @default("normal") // low, normal, high, urgent
  targetType  String    @default("all")    // all, role, user, institution
  targetRole  Role?                        // ADMIN, TEACHER, STUDENT (when targetType = "role")
  targetUserId String?                     // specific user id (when targetType = "user")
  targetUser  User?     @relation(fields: [targetUserId], references: [id], onDelete: SetNull)
  targetInstitutionId String?              // institution id (when targetType = "institution")
  targetInstitution   Institution? @relation(fields: [targetInstitutionId], references: [id], onDelete: SetNull)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================
// CLASS / SECTION / SUBJECT MODELS
// ============================================

model Class {
  id            String    @id @default(cuid())
  name          String                          // e.g., "Class 1", "Class 10"
  displayOrder  Int       @default(0)           // For sorting
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  sections      Section[]
  
  @@unique([name, institutionId])
}

model Section {
  id            String    @id @default(cuid())
  name          String                          // e.g., "A", "B", "C"
  classId       String
  class         Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  classTeacherId String?
  classTeacher  User?     @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  students           User[]              @relation("StudentSection")
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]
  routines           ClassRoutine[]
  exams              Exam[]
  assignments        Assignment[]
  studyMaterials     StudyMaterial[]
  
  @@unique([name, classId])
}

model Subject {
  id            String    @id @default(cuid())
  name          String                          // e.g., "Mathematics", "English"
  code          String?                         // e.g., "MATH101"
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  teacherAssignments TeacherAssignment[]
  studentMarks       StudentMark[]
  routines           ClassRoutine[]
  exams              Exam[]
  assignments        Assignment[]
  studyMaterials     StudyMaterial[]
  
  @@unique([name, institutionId])
}

model TeacherAssignment {
  id          String    @id @default(cuid())
  teacherId   String
  teacher     User      @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  sectionId   String
  section     Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([teacherId, sectionId, subjectId])
}

model Attendance {
  id          String           @id @default(cuid())
  studentId   String
  student     User             @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  sectionId   String
  section     Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User             @relation("AttendanceTakenBy", fields: [teacherId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)
  remarks     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  @@unique([studentId, date, sectionId])
}

model StudentMark {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation("StudentMarks", fields: [studentId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks       Float?
  maxMarks    Float     @default(100)
  examType    String    @default("exam")  // exam, quiz, assignment
  notes       String?
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================
// STUDENT PANEL MODELS
// ============================================

model ClassRoutine {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     User     @relation("RoutineTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  dayOfWeek   Int                // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime   String             // "09:00"
  endTime     String             // "09:45"
  roomNumber  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([sectionId, dayOfWeek, startTime])
}

model Exam {
  id            String      @id @default(cuid())
  name          String                          // "Mid Term", "Final"
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sectionId     String
  section       Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  date          DateTime    @db.Date
  startTime     String?                         // "10:00"
  endTime       String?                         // "12:00"
  roomNumber    String?
  syllabus      String?
  instructions  String?
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Assignment {
  id            String   @id @default(cuid())
  title         String
  description   String?
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       User     @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  dueDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  submissions   AssignmentSubmission[]
}

model AssignmentSubmission {
  id            String     @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  content       String?
  fileUrl       String?
  submittedAt   DateTime   @default(now())
  isLate        Boolean    @default(false)
  grade         String?
  feedback      String?
  
  @@unique([assignmentId, studentId])
}

model StudyMaterial {
  id            String   @id @default(cuid())
  title         String
  description   String?
  fileUrl       String?
  fileType      String?            // "pdf", "doc", "image", "video", "link"
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       User     @relation("MaterialTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String   @default("info")    // info, success, warning, urgent
  category    String   @default("general") // attendance, assignment, result, notice, exam, general
  isRead      Boolean  @default(false)
  link        String?                      // optional link to navigate to
  createdAt   DateTime @default(now())
}

